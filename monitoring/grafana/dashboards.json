{
  "dashboard": {
    "title": "User Order Platform Metrics",
    "schemaVersion": 39,
    "time": { "from": "now-6h", "to": "now" },
    "panels": [
      {
        "type": "timeseries",
        "title": "HTTP Request Rate (req/s)",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[5m])) by (route, status_code)",
            "legendFormat": "{{route}} [{{status_code}}]"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "p95 Request Latency",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))",
            "legendFormat": "{{route}}"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "5xx Error Rate",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m]))",
            "legendFormat": "5xx/s"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "Process Memory (RSS)",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "process_resident_memory_bytes",
            "legendFormat": "backend"
          }
        ]
      }
    ]
  }
}
