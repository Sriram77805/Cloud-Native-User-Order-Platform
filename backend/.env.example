# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=5000

# Local dev: docker-compose's mongodb service. In production, use a secret
# manager / K8s Secret - never hardcode credentials in any committed file.
MONGO_URL=mongodb://mongodb:27017/user-order-db

# Generate strong random secrets, e.g.: openssl rand -hex 64
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed browser origins for CORS + Socket.IO
FRONTEND_URL=http://localhost:3000
